<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/glass_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/glass_overlay" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_cover" android:layout_width="72dp" android:layout_height="72dp"
                android:scaleType="centerCrop" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:id="@+id/w_title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp"
                    android:textStyle="bold" android:singleLine="true" />
                <TextView android:id="@+id/w_artist" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="12sp"
                    android:singleLine="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp">
                    <ImageButton android:id="@+id/w_prev" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="40dp" android:background="@null" />
                    <ImageButton android:id="@+id/w_play" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="40dp" android:background="@null" />
                    <ImageButton android:id="@+id/w_next" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="40dp" android:background="@null" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
