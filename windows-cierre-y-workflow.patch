From 65ca2ebf4a7a8c400cf004b1806fd08198873169 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 10:43:52 +0000
Subject: [PATCH 2/2] CI: workflow que construye el instalador de Windows
 (rutas Windows/deskop-Windows, rama Windows)

---
 .github/workflows/build-windows.yml | 58 +++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)
 create mode 100644 .github/workflows/build-windows.yml

diff --git a/.github/workflows/build-windows.yml b/.github/workflows/build-windows.yml
new file mode 100644
index 0000000..a457c81
--- /dev/null
+++ b/.github/workflows/build-windows.yml
@@ -0,0 +1,58 @@
+# Construye el instalador de Windows (GlassPlayer-Setup.exe) con GitHub Actions.
+# Cada vez que cambies algo en deskop-Windows (o pulses «Run workflow») GitHub construye el instalador.
+name: Build Windows installer
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [Windows]
+    paths:
+      - "Windows/deskop-Windows/**"
+
+jobs:
+  build:
+    runs-on: windows-latest
+    defaults:
+      run:
+        working-directory: Windows/deskop-Windows
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: Windows/deskop-Windows/requirements-build.txt
+
+      - name: Instalar dependencias
+        run: python -m pip install -r requirements-build.txt
+
+      - name: Descargar yt-dlp, ffmpeg y deno
+        shell: pwsh
+        run: ./packaging/fetch_tools.ps1
+
+      - name: Generar la aplicación (PyInstaller)
+        run: pyinstaller packaging/glassplayer.spec --noconfirm --distpath dist --workpath build
+
+      - name: Comprobar que la app arranca y decodifica audio
+        shell: pwsh
+        run: |
+          $out = Join-Path $env:RUNNER_TEMP "selftest.txt"
+          $p = Start-Process "dist/GlassPlayer/GlassPlayer.exe" -ArgumentList "--selftest", $out -PassThru -Wait
+          if (-not (Test-Path $out)) { throw "La app no llegó a arrancar (código $($p.ExitCode))" }
+          $line = Get-Content $out
+          Write-Host $line
+          foreach ($need in "decode=True", "yt-dlp=True", "ffmpeg=True", "deno=True") {
+            if ($line -notmatch [regex]::Escape($need)) { throw "Autocomprobación fallida: falta $need" }
+          }
+
+      - name: Crear el instalador (Inno Setup)
+        shell: pwsh
+        run: |
+          choco install innosetup -y --no-progress
+          & "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe" "packaging\installer.iss"
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: GlassPlayer-Windows-Setup
+          path: Windows/deskop-Windows/installer_output/GlassPlayer-Setup.exe
-- 
2.43.0

